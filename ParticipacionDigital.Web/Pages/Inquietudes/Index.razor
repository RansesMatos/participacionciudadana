@page "/inquietudes"
@using Microsoft.EntityFrameworkCore
@using ParticipacionDigital.Core.Entities
@using ParticipacionDigital.Core.Enums
@using ParticipacionDigital.Infrastructure.Data
@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.AspNetCore.Identity
@inject AppDbContext DbContext
@inject NavigationManager Navigation
@inject AuthenticationStateProvider AuthStateProvider
@inject UserManager<Usuario> UserManager

<PageTitle>Foro Ciudadano</PageTitle>

<div class="row mb-4 align-items-center">
    <div class="col-md-8">
        <h2 class="fw-bold text-primary">🗣️ Foro de Inquietudes</h2>
        <p class="text-muted">Un espacio directo entre el ciudadano y las autoridades.</p>
    </div>
    <div class="col-md-4 text-md-end">
        <AuthorizeView>
            <Authorized>
                <a href="/inquietudes/crear" class="btn btn-primary gradient-btn shadow-sm">
                    ➕ Nueva Inquietud
                </a>
            </Authorized>
            <NotAuthorized>
                <a href="/Account/Login?returnUrl=/inquietudes" class="btn btn-outline-primary shadow-sm">
                    🔐 Iniciar Sesión para Participar
                </a>
            </NotAuthorized>
        </AuthorizeView>
    </div>
</div>

<AuthorizeView>
    <NotAuthorized>
        <div class="alert alert-info border-0 shadow-sm glass-card mb-4" role="alert">
            <h5 class="alert-heading fw-bold">👋 ¡Bienvenido Ciudadano!</h5>
            <p class="mb-0">
                Estás viendo los temas públicos. Para <strong>ver los detalles, votar o responder</strong>, necesitas 
                <a href="/Account/Login?returnUrl=/inquietudes" class="alert-link">iniciar sesión</a> o 
                <a href="/Account/Register" class="alert-link">registrarte</a>.
            </p>
        </div>
    </NotAuthorized>
</AuthorizeView>

@if (!string.IsNullOrEmpty(errorMessage))
{
    <div class="alert alert-danger" role="alert">
        @errorMessage
    </div>
}
else if (inquietudes == null)
{
    <div class="d-flex justify-content-center p-5">
        <div class="spinner-border text-primary" role="status">
            <span class="visually-hidden">Cargando...</span>
        </div>
    </div>
}
else if (!inquietudes.Any())
{
    <div class="card glass-card text-center p-5">
        <h4 class="text-muted">No hay inquietudes registradas aún.</h4>
        <p>Sé el primero en compartir tu opinión.</p>
        <div class="mt-3">
             <AuthorizeView>
                <Authorized>
                    <a href="/inquietudes/crear" class="btn btn-outline-primary">Comenzar</a>
                </Authorized>
                <NotAuthorized>
                    <a href="/Account/Login" class="btn btn-outline-primary">Iniciar Sesión</a>
                </NotAuthorized>
            </AuthorizeView>
        </div>
    </div>
}
else
{
    <div class="row">
        @foreach (var item in inquietudes)
        {
            if (!item.Activa && !EsModerador) continue;

            <div class="col-md-12 mb-3">
                <div class="card glass-card hover-lift @(!item.Activa ? "border-warning border-2" : "")">
                    <div class="card-body">
                        <div class="d-flex justify-content-between align-items-start">
                            <div style="width: 100%">
                                <h5 class="card-title fw-bold">
                                    @if (!item.Activa)
                                    {
                                        <span class="badge bg-warning text-dark me-2">🚫 Oculto</span>
                                    }
                                    <AuthorizeView>
                                        <Authorized>
                                            <a href="/inquietudes/@item.Id" class="text-decoration-none text-dark stretched-link">
                                                @item.Titulo
                                            </a>
                                        </Authorized>
                                        <NotAuthorized>
                                            <a href="/Account/Login?returnUrl=/inquietudes/@item.Id" class="text-decoration-none text-dark stretched-link">
                                                @item.Titulo
                                            </a>
                                            <span class="badge bg-secondary ms-2" style="font-size: 0.6em; position: relative; z-index: 2;">🔒 Requiere acceso</span>
                                        </NotAuthorized>
                                    </AuthorizeView>
                                </h5>
                                <h6 class="card-subtitle mb-2 text-muted small">
                                    Por @(item.Autor?.Nombre ?? "Usuario") • @item.FechaCreacion.ToString("dd MMM yyyy")
                                </h6>
                                <p class="card-text text-truncate" style="max-width: 800px;">
                                    @item.Descripcion
                                </p>
                                
                                <AuthorizeView>
                                    <NotAuthorized>
                                        <div class="mt-2">
                                            <a href="/Account/Login?returnUrl=/inquietudes/@item.Id" class="btn btn-sm btn-light border position-relative" style="z-index: 2;">
                                                Leer más...
                                            </a>
                                        </div>
                                    </NotAuthorized>
                                </AuthorizeView>
                            </div>
                            <div class="text-center ms-3">
                                <span class="badge bg-light text-dark border">
                                    💬 @(item.Respuestas?.Count ?? 0)
                                </span>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>
}

@code {
    private List<Inquietud>? inquietudes;
    private string? errorMessage;
    private bool EsModerador = false;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            var authState = await AuthStateProvider.GetAuthenticationStateAsync();
            var user = authState.User;
            EsModerador = user.IsInRole(RolUsuario.Administrador.ToString()) || user.IsInRole(RolUsuario.Moderador.ToString());

            var query = DbContext.Inquietudes
                .Include(i => i.Autor)
                .Include(i => i.Respuestas)
                .OrderByDescending(i => i.FechaCreacion)
                .AsNoTracking();

            // if (!EsModerador)
            // {
            //     query = query.Where(i => i.Activa);
            // } 
            // Better to fetch all and filter in View to allow showing "Hidden" badge logic or just filter in memory if list is small. 
            // For rigorous security, filter in DB. filtering in DB for non-mods.
            
            if (!EsModerador)
            {
                inquietudes = await query.Where(i => i.Activa).ToListAsync();
            }
            else
            {
                inquietudes = await query.ToListAsync();
            }
        }
        catch (Exception ex)
        {
            errorMessage = $"Error al cargar inquietudes: {ex.Message} {ex.InnerException?.Message}";
            Console.WriteLine(ex);
        }
    }
}
