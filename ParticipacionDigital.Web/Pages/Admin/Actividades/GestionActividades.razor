@page "/admin/actividades-pendientes"
@using Microsoft.EntityFrameworkCore
@using ParticipacionDigital.Core.Entities
@using ParticipacionDigital.Infrastructure.Data
@using Microsoft.AspNetCore.Identity
@inject IDbContextFactory<AppDbContext> DbFactory
@inject UserManager<Usuario> UserManager
@inject AuthenticationStateProvider AuthStateProvider
@inject NavigationManager Navigation

<PageTitle>Gestión de Actividades - Participación Digital</PageTitle>

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2>Actividades Pendientes de Aprobación</h2>
    </div>

    @if (!string.IsNullOrEmpty(successMessage))
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            @successMessage
            <button type="button" class="btn-close" @onclick="() => successMessage = null"></button>
        </div>
    }

    @if (pendingActivities == null)
    {
         <div class="d-flex justify-content-center">
            <div class="spinner-border text-primary" role="status">
                <span class="visually-hidden">Cargando...</span>
            </div>
        </div>
    }
    else if (!pendingActivities.Any())
    {
        <div class="alert alert-info text-center">
            <i class="bi bi-check-circle"></i> No hay actividades pendientes de aprobación.
        </div>
    }
    else
    {
        <div class="row row-cols-1 row-cols-md-2 g-4">
            @foreach (var actividad in pendingActivities)
            {
                <div class="col">
                    <div class="card h-100 shadow-sm border-danger">
                        <div class="card-header bg-danger text-white d-flex justify-content-between align-items-center">
                            <span>Pendiente</span>
                            <small class="badge bg-light text-dark">@(actividad.Alcaldia?.Nombre ?? "Global")</small>
                        </div>
                        <div class="card-body">
                            <h5 class="card-title fw-bold">@actividad.Titulo</h5>
                            <h6 class="card-subtitle mb-2 text-muted">Originalmente creado: @actividad.FechaCreacion.ToShortDateString()</h6>
                            
                            <p class="card-text">@actividad.Descripcion</p>
                            
                            <ul class="list-group list-group-flush mb-3">
                                <li class="list-group-item"><i class="bi bi-geo-alt"></i> <strong>Lugar:</strong> @actividad.Lugar</li>
                                <li class="list-group-item"><i class="bi bi-calendar"></i> <strong>Fecha:</strong> @actividad.FechaRealizacion.ToString("g")</li>
                            </ul>

                            @if (!string.IsNullOrEmpty(actividad.ImagenPath))
                            {
                                <div class="mb-3">
                                    <img src="@actividad.ImagenPath" class="img-fluid rounded" style="max-height: 150px;" alt="Vista previa" />
                                </div>
                            }
                        </div>
                        <div class="card-footer bg-white border-0 d-flex justify-content-end gap-2 pb-3">
                            <button class="btn btn-outline-danger" @onclick="() => RejectActivity(actividad)">
                                <i class="bi bi-x-circle"></i> Rechazar
                            </button>
                            <button class="btn btn-success" @onclick="() => ApproveActivity(actividad)">
                                <i class="bi bi-check-circle"></i> Aprobar
                            </button>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
</div>

@code {
    private List<Actividad> pendingActivities;
    private string? successMessage;
    
    // Authorization Context
    private bool isMasterAdmin = false;
    private int? currentUserAlcaldiaId;

    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        var user = await UserManager.GetUserAsync(authState.User);
        
        if (user != null)
        {
            var roles = await UserManager.GetRolesAsync(user);
            if (!roles.Contains("Administrador") && !roles.Contains("Moderador"))
            {
                Navigation.NavigateTo("/");
                return;
            }

            currentUserAlcaldiaId = user.AlcaldiaId;
             if (currentUserAlcaldiaId == null)
            {
                isMasterAdmin = true;
            }
            
            await LoadPendingActivities();
        }
        else
        {
             Navigation.NavigateTo("/Identity/Account/Login");
        }
    }

    private async Task LoadPendingActivities()
    {
        using var context = DbFactory.CreateDbContext();
        var query = context.Actividades
            .Include(a => a.Alcaldia)
            .Where(a => !a.IsApproved);

        if (!isMasterAdmin && currentUserAlcaldiaId.HasValue)
        {
            query = query.Where(a => a.AlcaldiaId == currentUserAlcaldiaId);
        }
        
        pendingActivities = await query.OrderBy(a => a.FechaCreacion).ToListAsync();
    }

    private async Task ApproveActivity(Actividad actividad)
    {
        using var context = DbFactory.CreateDbContext();
        var item = await context.Actividades.FindAsync(actividad.Id);
        if (item != null)
        {
            item.IsApproved = true;
            await context.SaveChangesAsync();
            successMessage = $"Actividad '{actividad.Titulo}' aprobada.";
            await LoadPendingActivities();
        }
    }

    private async Task RejectActivity(Actividad actividad)
    {
         using var context = DbFactory.CreateDbContext();
        var item = await context.Actividades.FindAsync(actividad.Id);
        if (item != null)
        {
            // Optionally delete image file
            // if (!string.IsNullOrEmpty(item.ImagenPath)) { ... }

            context.Actividades.Remove(item);
            await context.SaveChangesAsync();
            successMessage = $"Actividad '{actividad.Titulo}' rechazada y eliminada.";
            await LoadPendingActivities();
        }
    }
}
